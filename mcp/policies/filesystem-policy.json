{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "policyName": "mcp-filesystem-policy",
  "description": "Restricts MCP filesystem access to workspace boundaries and denies privileged access.",
  "flags": {
    "allowUnrestrictedFileAccess": false,
    "noSandbox": false,
    "ignoreHttpsErrors": false
  },
  "filesystemBounds": {
    "workspaceRootOnly": true,
    "allowedOutputDirectories": [
      ".artifacts",
      "test-results"
    ],
    "prohibitedPaths": [
      "/etc",
      "/var",
      "/tmp",
      "~/.ssh",
      "~/.gnupg",
      "~/.aws",
      "~/.gemini"
    ]
  }
}
