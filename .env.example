# LunaCare Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ==========================================
# Android Build Config
# ==========================================

# Signing config for release builds (set as CI/CD secrets)
KEYSTORE_PATH=my-upload-key.jks
STORE_PASSWORD=
KEY_PASSWORD=

# ==========================================
# Firebase / AI (optional)
# ==========================================
# Firebase project ID (if using Firebase AI / Gemini backend)
FIREBASE_PROJECT_ID=

# AI API endpoint (if using a custom AI backend)
EXPO_PUBLIC_AI_API_ENDPOINT=

# ==========================================
# Supabase (optional — for cloud sync feature)
# ==========================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NEVER set the SERVICE_ROLE_KEY in client apps
# Use it only in scripts/audit_security.py on a secured server
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# Security
# ==========================================
# Minimum PIN length (default: 4)
MIN_PIN_LENGTH=4

# AI free tier limit (messages per month)
AI_FREE_TIER_LIMIT=20

# AI premium tier limit (messages per month)
AI_PREMIUM_TIER_LIMIT=200

# ==========================================
# Audit script
# ==========================================
AUDIT_LOG_EXPORT_PATH=audit_export.json
AUDIT_REPORT_PATH=audit_report.json
