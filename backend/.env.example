# LunaCare Backend Configuration Template
# Copy to .env and replace placeholders with production secrets

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Minimum 32-character high-entropy secret keys
JWT_SECRET=
SERVER_SECRET=
INTERNAL_SERVICE_KEY=

# Trusted AI API key (kept on backend only, NEVER on client)
GEMINI_API_KEY=

# Database connection (PostgreSQL / Supabase)
DATABASE_URL=

# Allowed origins for CORS (comma separated)
CORS_ORIGIN=http://localhost:3000

# Rust file inspector binary path
RUST_INSPECTOR_PATH=./backend-rust/file-inspector

# AI usage limits
AI_FREE_TIER_LIMIT=20
AI_PREMIUM_TIER_LIMIT=200
